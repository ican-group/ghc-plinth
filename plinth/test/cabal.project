repository cardano-haskell-packages
  url: https://chap.intersectmbo.org/
  secure: True
  root-keys:
    3e0cce471cf09815f930210f7827266fd09045445d65923e6d0238a6cd15126f
    443abb7fb497a134c343faf52f0b659bd7999bc06b7f63fa76dc99d631f9bea1
    a86a1f6ce86c449c46666bda44268677abf29b5b2d2eb5ec7af903ec2f117a82
    bcec67e8e99cabfa7764d75ad9b158d72bfacf70ca1d0ec8bc6b4406d1bf8413
    c00aae8461a256275598500ea0e187588c35a5d5d7454fb57eac18d9edb86a56
    d4a35cd3121aa00d18544bb0ac01c3e1691d618f462c46129271bccf39f7e8ee

-- Keep the solver set-up here (index-states, cardano-base pin, constraints,
-- allow-newer) in sync with the website tutorial and how-to/use, which show
-- the same stack to end users.
index-state:
  -- Bump both the following dates if you need newer packages from Hackage
  , hackage.haskell.org 2026-08-06T04:37:23Z
  -- Bump this if you need newer packages from CHaP
  , cardano-haskell-packages 2026-08-05T05:00:53Z

packages:
  ./.

optional-packages:
  ../../plutus/plutus-tx
  ../../plutus/plutus-core
  ../../plutus/plutus-ledger-api
  -- plutus-tx-plugin is here only so plinth-test.sh can build and run its
  -- test-suites (the canonical Plinth compiler tests) under uplc-ghc. The
  -- example project below does not depend on it; the compiler is built into
  -- uplc-ghc. plutus-metatheory is a transitive dependency of plutus-tx-plugin.
  ../../plutus/plutus-tx-plugin
  ../../plutus/plutus-metatheory

-- The test-suites of plutus-tx-plugin and plutus-tx have the goldens of
-- upstream, which compiles 'case' on Data (protocol version 12). The plugin
-- default is the protocol version of mainnet (11), so compile these suites for
-- version 12; BuiltinCasing.PV10 and PV11 test the lower versions. See Note
-- [Target protocol version] in plutus:PlutusTx.Compiler.Types.
package plutus-tx-plugin
  ghc-options: -fplugin-opt Plinth.Plugin:target-protocol-version=12

package plutus-tx
  ghc-options: -fplugin-opt Plinth.Plugin:target-protocol-version=12

source-repository-package
    type: git
    location: https://github.com/ican-group/cardano-base
    subdir: cardano-crypto-class
            cardano-crypto-praos
    tag: 055ebbcc73e1cb234f1fd3fa237a4fb087130183

source-repository-package
    type: git
    location: https://github.com/haskell-cryptography/blst-clib
    tag: 0fd1d38d5ceed5529ac646efae3095b493a97927

source-repository-package
    type: git
    location: https://github.com/haskell-cryptography/libsodium-clib
    tag: 985c18f75a71ff721370940666d71fda53edbb14

source-repository-package
    type: git
    location: https://github.com/haskell-cryptography/secp256k1-clib
    tag: 211b95baad422966c9e719ed70cbc189c58eaae5


package secp256k1-clib
  flags: +schnorrsig +recovery +ecdh +extrakeys

package cardano-crypto-class
  flags: +use-haskell-clibs

package cardano-crypto-praos
  flags: +use-haskell-clibs

package sodium-clib
  -- we need to disable -fPIE in libsodium, otherwise the Haskell code tries to
  -- link with -fPIE but the static boot libraries haven't been built with -fPIE
  -- and the link phase fails with cryptic error messages.
  configure-options: --enable-pie=no

-- Mirror the upstream plutus cabal.project solver directives (the submodule's
-- own cabal.project is not used by this build).
constraints:
  -- https://github.com/IntersectMBO/plutus/pull/7236
  , setup.optparse-applicative >=0.19.0.0

allow-newer:
  , turtle:optparse-applicative
  -- https://github.com/tweag/HaskellR/pull/420
  , inline-r:singletons-th
  , inline-r:aeson
  , inline-r:text
  , inline-r:template-haskell
  , inline-r:deepseq
  , inline-r:bytestring
  , inline-r:containers
  , inline-r:primitive